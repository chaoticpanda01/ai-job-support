# =============================================================================
# Backend Environment Variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development                          # development | staging | production
APP_NAME="Japan Job Support API"
APP_VERSION=0.1.0
DEBUG=true                                   # Set false in production
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
ENABLE_DOCS=true                             # /docs, /redoc, /openapi.json — leave unset (false) in production

# --- API Server ---
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000        # Comma-separated in production
ALLOWED_HOSTS=localhost,127.0.0.1            # Comma-separated

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_support
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Sync URL for Alembic migrations (uses psycopg2, not asyncpg)
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_job_support

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Clerk Authentication ---
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JWKS URL for JWT validation — do not change unless using a custom Clerk domain
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN.clerk.accounts.dev/.well-known/jwks.json

# --- Anthropic (Claude) ---
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_RETRIES=3

# --- AI Fallback Provider (optional) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_FALLBACK_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=false                   # Set true to enable OpenAI fallback

# --- AWS S3 ---
# Use Cloudflare R2 by setting endpoint_url in file_storage.py
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-northeast-1
S3_BUCKET_NAME=ai-job-support-files
S3_PRESIGNED_URL_EXPIRY_SECONDS=900        # 15 minutes

# --- Stripe ---
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_BASIC=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=http://localhost:3000/billing?session=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?session=cancel

# --- Resend (Email) ---
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Japan Job Support"

# --- Sentry ---
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1             # 10% in dev; lower in production

# --- Rate Limiting ---
RATE_LIMIT_RESUME_UPLOAD_PER_HOUR=5
RATE_LIMIT_AI_FEATURES_PER_HOUR_FREE=20
RATE_LIMIT_JOB_TRANSLATE_PER_HOUR=10
RATE_LIMIT_GLOBAL_PER_IP_PER_MINUTE=60
TRUSTED_PROXY_HOPS=1                      # Number of trusted reverse proxies in front of the app (Render edge LB = 1). 0 = trust request.client.host only (e.g. local dev with no proxy).

# --- Document Generation ---
# PDF Japanese font support ships as a bundled repo asset
# (app/assets/fonts/) — no path config needed. See app/utils/pdf_generator.py.
JOB_TRANSLATION_CACHE_DAYS=7
